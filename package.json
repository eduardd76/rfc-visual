{
  "name": "rfc-visual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node_modules/typescript-7/bin/tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,css,json,jsonc,yml,yaml}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,css,json,jsonc,yml,yaml}\" --cache",
    "dev": "next dev --turbopack",
    "build": "next build",
    "sync:data": "bun scripts/sync-rfc-data.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.53.0",
    "mermaid": "^12.1.0",
    "next": "~16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "browserslist": "4.28.8",
    "ajv": "6.15.0",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fflate": "0.4.9",
    "flatted": "3.4.2",
    "katex": "0.18.2",
    "lodash-es": "^4.18.1",
    "minimatch@<4": "3.1.5",
    "picomatch@<3": "2.3.2",
    "postcss": "8.5.29",
    "rollup": "4.62.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "8.11.2",
    "vite": "7.3.6",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "~16.3.8",
    "jsdom": "30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.3.14 <2",
    "node": "22.x"
  },
  "packageManager": "bun@1.3.14"
}
